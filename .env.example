# Anthropic API key (required for real LLM calls: OCR, segmentation, grading, review)
ANTHROPIC_API_KEY=sk-ant-...

# Claude model per agent role
HUC_GRADER_MODEL=claude-opus-5-5
HUC_REVIEWER_MODEL=claude-opus-5-5
HUC_SEGMENTER_MODEL=claude-opus-5-5

# OCR: Claude Haiku transcribes each page image (images are sent to the Anthropic API)
HUC_OCR_MODEL=claude-haiku-5-5
# Seconds allowed per page request (the SDK also retries transient errors)
HUC_OCR_TIMEOUT_S=120
# Resolution used to rasterize PDF pages
HUC_PDF_DPI=200
# Longest side (px) of each page image sent to the OCR model (Claude downscales above 1568)
HUC_OCR_MAX_SIDE_PX=1568

# Where exams, submissions and grades are stored (JSON files)
HUC_DATA_DIR=./data
# Max parallel LLM calls per graph run, also OCR pages per file (LangGraph's max_concurrency)
HUC_MAX_CONCURRENCY=8
# Grades with confidence (0-1) below this threshold are sent to human review
HUC_HUMAN_REVIEW_THRESHOLD=0.7

# Optional: LangSmith tracing (also used by LangGraph Studio)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=huc
