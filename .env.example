# Anthropic API key (required for real LLM calls: OCR/reading, grading, review)
ANTHROPIC_API_KEY=sk-ant-...

# Claude model per grading role
HUC_GRADER_MODEL=claude-opus-5-5
HUC_REVIEWER_MODEL=claude-opus-5-5

# OCR: Claude Haiku reads all page images of a submission in one call and returns the
# answer to each question (images are sent to the Anthropic API)
HUC_OCR_MODEL=claude-haiku-5-5
# Seconds allowed per request (one request = a whole submission; the SDK retries transient errors)
HUC_OCR_TIMEOUT_S=300
# Resolution used to rasterize PDF pages
HUC_PDF_DPI=200
# Longest side (px) of each page image sent to the OCR model (Claude downscales above 1568)
HUC_OCR_MAX_SIDE_PX=1568

# Where exams, submissions and grades are stored (JSON files)
HUC_DATA_DIR=./data
# Max parallel LLM calls per grading run (LangGraph's max_concurrency)
HUC_MAX_CONCURRENCY=8
# Every exam is graded; scores with confidence (0-1) below this label the grade
# "needs teacher verification"
HUC_VERIFICATION_THRESHOLD=0.7

# Optional: LangSmith tracing (also used by LangGraph Studio)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=huc
