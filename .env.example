# Anthropic API key (required for real LLM calls: segmentation, grading, review)
ANTHROPIC_API_KEY=sk-ant-...

# Claude model per agent role
HUC_GRADER_MODEL=claude-opus-5-5
HUC_REVIEWER_MODEL=claude-opus-5-5
HUC_SEGMENTER_MODEL=claude-opus-5-5

# Local OCR with Ollama (page images never leave this machine).
# Run `ollama pull <model>` first. Prefer instruct tags (thinking tags are much slower on CPU).
HUC_OCR_MODEL=qwen3-vl:8b-instruct
HUC_OLLAMA_BASE_URL=http://localhost:11434
# Seconds allowed per page (CPU-only inference takes 1-3 min per page)
HUC_OCR_TIMEOUT_S=600
# Resolution used to rasterize PDF pages (images are capped at 2000 px on the longest side)
HUC_PDF_DPI=200

# Where exams, submissions and grades are stored (JSON files)
HUC_DATA_DIR=./data
# Max parallel LLM calls per graph run (passed as LangGraph's max_concurrency)
HUC_MAX_CONCURRENCY=8
# Grades with confidence (0-1) below this threshold are sent to human review
HUC_HUMAN_REVIEW_THRESHOLD=0.7

# Optional: LangSmith tracing (also used by LangGraph Studio)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=huc
